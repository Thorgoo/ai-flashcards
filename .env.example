SUPABASE_URL=###
SUPABASE_KEY=###
# Comma-separated emails allowed to sign in (empty = nobody)
ALLOWED_EMAILS=you@example.com
# Anthropic API key for AI calls (src/lib/ai)
ANTHROPIC_API_KEY=###
# live = real Claude calls; fake = canned responses from src/lib/ai/fixtures.ts (local Supabase only)
AI_MODE=live
# Used by the local Supabase stack (supabase/config.toml) for GitHub OAuth
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=###
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=###
