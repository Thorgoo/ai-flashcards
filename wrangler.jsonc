{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-flashcards",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Astro sessions; declared explicitly because Workers Builds previews cannot auto-provision it
  "kv_namespaces": [{ "binding": "SESSION", "id": "c5c7150d952f43dc83e3f7572905b2b8" }],
  "observability": {
    "enabled": true,
  },
}
