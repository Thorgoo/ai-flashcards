---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { Button } from "@/components/ui/button";
import { Flame, Trophy } from "lucide-react";
import HomeTopics from "@/components/topics/HomeTopics";
import { badgeCountLabel, streakHint, streakLabel } from "@/components/topics/labels";
import { getBadgeOverview } from "@/lib/badges/repository";
import { createClient } from "@/lib/supabase";
import { getStudyStreak, listTopicOverview } from "@/lib/topics/repository";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const [topics, streak, badges] = supabase
  ? await Promise.all([listTopicOverview(supabase), getStudyStreak(supabase), getBadgeOverview(supabase)])
  : [[], null, null];
const hint = streak ? streakHint(streak) : null;
---

<Layout title="Tematy">
  <div class="dark bg-background text-foreground min-h-screen">
    <main class="mx-auto max-w-2xl p-4">
      <Topbar />
      <div class="mb-4 flex items-center justify-between gap-4">
        <h1 class="text-2xl font-semibold">Twoje tematy</h1>
        <Button asChild>
          <a href="/topics/new">Nowy temat</a>
        </Button>
      </div>

      <div class="mb-4 grid gap-4 sm:grid-cols-2">
        {streak && (
          <section class="border-border bg-card text-card-foreground flex items-start gap-3 rounded-lg border p-3">
            <Flame className="text-muted-foreground mt-0.5 size-5 shrink-0" aria-hidden="true" />
            <div class="min-w-0">
              <p class="font-medium">{streakLabel(streak.days)}</p>
              {hint && <p class="text-muted-foreground text-sm">{hint}</p>}
            </div>
          </section>
        )}
        {badges && (
          <a
            href="/badges"
            class="border-border bg-card text-card-foreground hover:bg-accent flex items-start gap-3 rounded-lg border p-3 transition-colors"
          >
            <Trophy className="text-muted-foreground mt-0.5 size-5 shrink-0" aria-hidden="true" />
            <p class="font-medium">{badgeCountLabel(badges.earned.length)}</p>
          </a>
        )}
      </div>

      <HomeTopics client:load topics={topics} />
    </main>
  </div>
</Layout>
