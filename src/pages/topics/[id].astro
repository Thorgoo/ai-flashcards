---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import TopicEditor from "@/components/topics/TopicEditor";
import { createClient } from "@/lib/supabase";
import { getFlashcardSummary, hasReadyBatch } from "@/lib/topics/flashcard-repository";
import type { SubtopicMastery } from "@/lib/topics/mastery";
import { getQuizState, type QuizState } from "@/lib/topics/quiz-repository";
import { getTopic } from "@/lib/topics/repository";
import { isUuid } from "@/lib/topics/schemas";
import { countDueCards } from "@/lib/topics/study-repository";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const id = Astro.params.id ?? "";
// Missing and other accounts' topics look the same: not found.
const found = supabase && isUuid(id) ? await getTopic(supabase, id) : null;
if (!found) {
  Astro.response.status = 404;
}
const autoGenerate =
  found !== null &&
  found.topic.status === "draft" &&
  found.subtopics.length === 0 &&
  Astro.url.searchParams.get("generate") === "1";
// A failed quiz read must not take the topic down with it; the quiz page reports it.
let quizState: QuizState | null = null;
if (supabase && found?.topic.status === "confirmed") {
  try {
    quizState = await getQuizState(supabase, found.topic.id);
  } catch (error) {
    // eslint-disable-next-line no-console
    console.error("[topics] reading quiz failed", error);
  }
}
const quiz = quizState
  ? {
      generating: quizState.quiz.status === "generating",
      answered: quizState.quiz.answered,
      total: quizState.quiz.total,
      completed: quizState.quiz.completedAt !== null,
    }
  : null;
// Same for flashcards: a failed read only shows "Wygeneruj fiszki"; the flashcards page reports it.
let hasFlashcards = false;
let study: { dueCount: number | null } | null = null;
// Per-subtopic mastery once a batch is ready; a failed read shows the list without it.
let mastery: SubtopicMastery[] | null = null;
let topicMastered = false;
if (supabase && found && quiz?.completed) {
  try {
    const flashcards = await getFlashcardSummary(supabase, found.topic.id);
    hasFlashcards = flashcards !== null;
    if (flashcards && hasReadyBatch(flashcards)) {
      study = { dueCount: null };
      mastery = flashcards.subtopics;
      topicMastered = flashcards.topicMastered;
    }
  } catch (error) {
    // eslint-disable-next-line no-console
    console.error("[topics] reading flashcards failed", error);
  }
}
// A failed count still shows "Ucz się", only without the number.
if (supabase && found && study) {
  try {
    study.dueCount = await countDueCards(supabase, found.topic.id);
  } catch (error) {
    // eslint-disable-next-line no-console
    console.error("[topics] counting due flashcards failed", error);
  }
}
---

<Layout title={found ? found.topic.name : "Nie znaleziono tematu"}>
  <div class="dark bg-background text-foreground min-h-screen">
    <main class="mx-auto max-w-2xl p-4">
      <Topbar />
      {found ? (
        <TopicEditor
          client:load
          initial={found}
          autoGenerate={autoGenerate}
          quiz={quiz}
          hasFlashcards={hasFlashcards}
          study={study}
          mastery={mastery}
          topicMastered={topicMastered}
        />
      ) : (
        <div class="space-y-4">
          <h1 class="text-2xl font-semibold">Nie znaleziono tematu</h1>
          <a href="/dashboard" class="text-primary underline underline-offset-4">
            Wróć do listy tematów
          </a>
        </div>
      )}
    </main>
  </div>
</Layout>
